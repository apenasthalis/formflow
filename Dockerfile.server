# syntax=docker/dockerfile:1

# Imagem do backend (API Node + TypeScript + Express + Prisma).
# Dois modos:
#   dev  -> tsx watch, recarrega ao salvar (código montado via volume no compose)
#   prod -> compilado com tsc e executado por node

FROM node:22-alpine AS base
RUN apk add --no-cache openssl curl
WORKDIR /app

FROM base AS deps
COPY server/package.json server/package-lock.json* ./
RUN npm ci --no-audit --no-fund
# O schema precisa estar presente antes do generate.
COPY server/prisma ./prisma
RUN npx prisma generate

FROM deps AS development
ENV NODE_ENV=development
COPY server/tsconfig*.json server/vitest.config.ts ./
COPY server/scripts ./scripts
COPY server/src ./src
# Testes de integração disponíveis dentro do container de desenvolvimento.
COPY server/tests ./tests
EXPOSE 4000
CMD ["npm", "run", "dev"]

FROM deps AS build
COPY server/tsconfig*.json ./
COPY server/scripts ./scripts
COPY server/src ./src
RUN npm run build

FROM base AS production
ENV NODE_ENV=production
COPY server/package.json server/package-lock.json* ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY server/prisma ./prisma
RUN npx prisma generate
COPY --from=build /app/dist ./dist
COPY server/scripts ./scripts
RUN addgroup -S app && adduser -S app -G app && chown -R app:app /app
USER app
EXPOSE 4000
CMD ["node", "dist/index.js"]
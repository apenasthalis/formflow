# ----------------------------------------------------------------------------
# FormFlow — variáveis de ambiente (copie para .env e ajuste os valores)
# Nenhum valor real de produção deve ser commitado: apenas este exemplo.
# ----------------------------------------------------------------------------

# --- Aplicação / porta pública (Nginx) ---------------------------------------
# Porta em que o Nginx publica a aplicação. Use 80 para http://localhost.
APP_HTTP_PORT=80
APP_HTTP_URL=http://localhost

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=formflow
POSTGRES_DB=formflow
# Obrigatória: gere uma senha forte, por exemplo `openssl rand -base64 24`.
POSTGRES_PASSWORD=troque-esta-senha
# Porta exposta apenas em localhost, para usar psql/psql GUI.
POSTGRES_HOST_PORT=5432

# --- Segurança ---------------------------------------------------------------
# Segredo usado para assinar cookies e derivar hashes de token/IP.
# Gere um valor novo: openssl rand -base64 48
APP_SECRET=troque-este-segredo-com-openssl-rand-base64-48

# true somente quando a aplicação estiver atrás de HTTPS.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
SESSION_TTL_SECONDS=43200

# --- Limites de requisição ---------------------------------------------------
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_PUBLIC_MAX=120

# --- Build dos containers ----------------------------------------------------
# dev  = tsx watch / vite dev (recarrega ao salvar, sem rebuild)
# prod = build real; para o build do frontend use sempre `npm run preview`.
NODE_ENV=development
SERVER_BUILD_TARGET=development
CLIENT_BUILD_TARGET=development

# --- Primeiro administrador (usado pelo script, nunca fica no banco) ---------
# Usado por: docker compose run --rm server npm run admin:create -- --email <EMAIL> --name "<NOME>"
ADMIN_EMAIL=admin@exemplo.com
ADMIN_NAME=Administrador

# --- Dados de demonstração (opcionais) ---------------------------------------
# Usado por: docker compose run --rm server npm run seed
ADMIN_DEMO_EMAIL=demo@exemplo.com
ADMIN_DEMO_PASSWORD=troque-esta-senha-demo-com-12-ou-mais